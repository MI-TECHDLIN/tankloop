# Copy to .env (ignored). Flutter accepts --dart-define-from-file=/absolute/path/.env
# simulation is deterministic and never contacts Supabase.
TANKLOOP_MODE=simulation
SIMULATION_SEED=20261101
SIMULATION_DAY=10
PORTAL_BASE_URL=http://localhost:8081
# For Supabase mode, use `supabase status` after `supabase start`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Never put a service-role or secret key in a Flutter build.
